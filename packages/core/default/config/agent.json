{
  "version": 7,
  "enabled": false,
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "kind": "openai",
      "enabled": true,
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "",
      "model": "",
      "timeout": 30000
    }
  ],
  "routing": {
    "primary": "openai",
    "fallback": []
  },
  "trigger": {
    "private": true,
    "groupMention": true,
    "wakeWords": []
  },
  "limits": {
    "maxToolRounds": 8,
    "maxToolOutputBytes": 65536,
    "maxRecentMessages": 40,
    "maxSubagents": 3
  },
  "policy": {
    "approvalTtlMs": 300000,
    "hardDeny": [],
    "rules": [],
    "defaults": {
      "read": "allow",
      "write": "ask",
      "external": "ask",
      "destructive": "ask"
    }
  },
  "learning": {
    "memory": true,
    "skills": true,
    "reflection": {
      "enabled": true,
      "afterFailure": true,
      "successInterval": 5
    },
    "curator": {
      "enabled": true,
      "intervalHours": 168,
      "minIdleMinutes": 120,
      "staleAfterDays": 30,
      "archiveAfterDays": 90
    },
    "promotion": {
      "autoMemory": true,
      "autoRouting": true,
      "autoDeclarativeSkills": true,
      "minEvidence": 3,
      "minSuccessRate": 0.8,
      "maxRegressionRate": 0.05,
      "autoRollback": true,
      "rollbackWindow": 20
    }
  },
  "recovery": {
    "enabled": true,
    "maxCycles": 2,
    "maxDiagnosticCalls": 8,
    "maxDurationMs": 120000,
    "researchPolicy": "evidence-driven",
    "repair": {
      "requireApproval": true,
      "workspaceRoots": []
    }
  },
  "tools": {
    "disabled": [],
    "disabledToolsets": []
  },
  "mcp": {
    "enabled": false,
    "servers": []
  },
  "scriptRuntime": {
    "pythonExecutable": "",
    "defaultTimeoutMs": 30000,
    "maxTimeoutMs": 120000,
    "defaultMaxOutputBytes": 65536,
    "maxOutputBytes": 1048576
  }
}
