{
  "version": 10,
  "enabled": false,
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "kind": "openai",
      "protocol": "chat-completions",
      "enabled": true,
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "",
      "model": "",
      "timeout": 30000
    }
  ],
  "routing": {
    "primary": "openai",
    "fallback": []
  },
  "trigger": {
    "private": true,
    "groupMention": true,
    "wakeWords": []
  },
  "limits": {
    "maxToolRounds": 99,
    "maxToolOutputBytes": 65536,
    "maxRecentMessages": 40,
    "maxSubagents": 3
  },
  "context": {
    "defaultWindowTokens": 65536,
    "softLimitRatio": 0.5,
    "hardLimitRatio": 0.85,
    "protectedRecentMessages": 12,
    "summaryTargetTokens": 4096
  },
  "journal": {
    "recoveryAttempts": 2,
    "eventRetentionDays": 7
  },
  "tasks": {
    "enabled": true,
    "maxItems": 64,
    "completionGuardRetries": 2
  },
  "policy": {
    "approvalTtlMs": 300000,
    "hardDeny": [],
    "rules": [],
    "defaults": {
      "read": "allow",
      "write": "ask",
      "external": "ask",
      "destructive": "ask"
    },
    "autoApproveTrustedReversible": true
  },
  "learning": {
    "memory": true,
    "skills": true,
    "reflection": {
      "enabled": true,
      "afterFailure": true,
      "successInterval": 5
    },
    "curator": {
      "enabled": true,
      "intervalHours": 168,
      "minIdleMinutes": 120,
      "staleAfterDays": 30,
      "archiveAfterDays": 90
    },
    "promotion": {
      "autoMemory": true,
      "autoRouting": true,
      "autoDeclarativeSkills": true,
      "minEvidence": 3,
      "minSuccessRate": 0.8,
      "maxRegressionRate": 0.05,
      "autoRollback": true,
      "rollbackWindow": 20
    }
  },
  "memory": {
    "retrieval": {
      "maxCandidates": 50,
      "maxItems": 8,
      "maxPromptTokens": 1200,
      "minScore": 0.25,
      "recencyHalfLifeDays": 30
    }
  },
  "execution": {
    "isolationMode": "compat",
    "minimumIsolation": "none",
    "hookTimeoutMs": 5000,
    "maxModelCalls": 40,
    "maxTurnDurationMs": 300000
  },
  "recovery": {
    "enabled": true,
    "maxCycles": 2,
    "maxDiagnosticCalls": 99,
    "maxDurationMs": 120000,
    "researchPolicy": "evidence-driven",
    "repair": {
      "requireApproval": true,
      "workspaceRoots": []
    }
  },
  "tools": {
    "disabled": [],
    "disabledToolsets": []
  },
  "mcp": {
    "enabled": false,
    "servers": []
  },
  "scriptRuntime": {
    "pythonExecutable": "",
    "defaultTimeoutMs": 30000,
    "maxTimeoutMs": 120000,
    "defaultMaxOutputBytes": 65536,
    "maxOutputBytes": 1048576
  }
}
